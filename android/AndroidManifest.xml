<?xml version="1.0" encoding="utf-8"?>
<!-- CF Evolution for Android (first version, 2026-11-17). Built without Gradle by
     build-android.sh; the screens are made in code, and the only resources are the icon and the theme (res/). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cfevolution.android">

    <!-- No storage permissions: the game folder is chosen in Android's folder picker, which
         gives access to that folder only; its files are copied in for the core and changes
         written back (screens/FolderMirror). -->

    <!-- Turning the phone does not restart a screen (a generation keeps running and its
         dialogs stay): the screens are made in code and lay themselves out again. -->
    <application
        android:label="CF Evolution"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.CFE"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".FolderActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".TrackActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".HorizonActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".PictureActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".GameFileActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".CircuitsActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".ExecutableActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".OptionsActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
    </application>
</manifest>
