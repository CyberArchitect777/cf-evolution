<?xml version="1.0" encoding="utf-8"?>
<!-- CF Evolution for Android (first version, 2026-11-17). Built without Gradle by
     build-android.sh; no resources, the screens are made in code. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cfevolution.android">

    <!-- The core reads and writes game files by path, so the app needs access to
         the folder the game files are in: "All files access" from Android 11, the
         storage permissions before that. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Turning the phone does not restart a screen (a generation keeps running and its
         dialogs stay): the screens are made in code and lay themselves out again. -->
    <application
        android:label="CF Evolution"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".FolderActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".TrackActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <activity android:name=".ExecutableActivity" android:exported="false" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
    </application>
</manifest>
